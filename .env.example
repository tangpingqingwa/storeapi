# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
STOREAPI_DATABASE=/app/data/storeapi.sqlite

# Optional first key when the keys table is empty. st_live_... or st_test_...
# STOREAPI_BOOTSTRAP_KEY=st_live_replace_me

# Off by default. Set to 1 (or true/yes) to use documented iTunes JSON + public Play pages.
# Leave unset or 0 in CI. STOREAPI_FIXTURE_ONLY=1 wins and keeps fixtures.
STOREAPI_LIVE_STORES=0
# STOREAPI_FIXTURE_ONLY=1
