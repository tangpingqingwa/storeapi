# Optional. Required in production.
# STOREAPI_DATABASE=./data/storeapi.sqlite

# Optional bootstrap key when the keys table is empty.
# STOREAPI_BOOTSTRAP_KEY=st_test_dev

# Off by default. Set to 1/true to use live iTunes JSON + public Play pages.
# Never enable in CI. STOREAPI_FIXTURE_ONLY=1 wins and keeps fixtures.
# STOREAPI_LIVE_STORES=0
# STOREAPI_FIXTURE_ONLY=1
